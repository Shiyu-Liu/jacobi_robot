      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>
  <!-- ROS-Industrial 'flange' frame: attachment point for EEF models (attachment point to ABB arm) -->
  <link name="linear_axis_flange"/>
  <joint name="linear_axis_joint1-flange" type="fixed">
    <origin rpy="0 0 0" xyz="0.6 0.43 0.55"/>
    <parent link="linear_axis_link_1"/>
    <child link="linear_axis_flange"/>
  </joint>
  <!-- ABB robotic arm links -->
  <link name="abb_arm_base_link">
    <collision name="collision">
      <geometry>
        <mesh filename="package://jacobi_robot/urdf/abb_irb6700_150_320/meshes/collision/base_link.obj"/>
