  <!-- end of link list -->
  <!-- joint list -->
  <!-- linear axis joints -->
  <joint name="linear_axis_joint_1" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <parent link="linear_axis_base_link"/>
    <child link="linear_axis_link_1"/>
    <limit effort="1000" lower="-0.41" upper="7.3" velocity="1.0"/>
  </joint>
  <!-- Connection joint -->
  <joint name="connection_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="linear_axis_flange"/>
    <child link="abb_arm_base_link"/>
  </joint>
  <!-- ABB robotic arm joints -->
  <joint name="abb_arm_joint_1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.780"/>
    <axis xyz="0 0 1"/>
    <parent link="abb_arm_base_link"/>
    <child link="abb_arm_link_1"/>
    <limit default="0" effort="0" lower="-2.9670597283903604" upper="2.9670597283903604" velocity="1.7453292519943295"/>
  </joint>
  <joint name="abb_arm_joint_2" type="revolute">
