<?xml version="1.0" ?>
<robot name="jacobi_robot">
  <!-- link list -->
  <!-- linear axis links -->
  <link name="linear_axis_base_link">
    <collision name="collision">
      <geometry>
        <mesh filename="package://jacobi_robot/urdf/linear_axis/meshes/collision/base_link.obj"/>
      </geometry>
      <material>
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </collision>
    <visual name="visual">
      <geometry>
        <mesh filename="package://jacobi_robot/urdf/linear_axis/meshes/visual/base_link.glb"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>
  <link name="linear_axis_link_1">
    <collision name="collision">
      <geometry>
        <mesh filename="package://jacobi_robot/urdf/linear_axis/meshes/collision/link_1.obj"/>
      </geometry>
      <material>
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </collision>
    <visual name="visual">
